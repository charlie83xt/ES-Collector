# ===== IBKR login =====
TWS_USERID=YOUR_IBKR_USERNAME
TWS_PASSWORD=YOUR_IBKR_PASSWORD
TRADING_MODE=paper           # paper or live
READ_ONLY_API=no

# Optional VNC: leave unset to disable
# VNC_SERVER_PASSWORD=someStrongPassword

# Auto restart can reduce 2FA prompts in some setups (depends on your IB config)
# TWOFA_TIMEOUT_ACTION=restart
# AUTO_RESTART_TIME=11:59 PM
TIME_ZONE=Etc/UTC

# ===== IB API connection =====
IB_HOST=ib-gateway
IB_PORT=4002                 # 4002 paper, 4001 live
IB_CLIENT_ID=101

# ===== Instrument config =====
# We'll use IB "continuous future" contract for ES:
SYMBOL=ES
EXCHANGE=CME
DB_SYMBOL=ES_CONTFUT

# ===== Supabase Postgres =====
# Use direct connection if IPv6 works, else use Supavisor "session mode" pooler.
DATABASE_URL=postgresql://postgres:YOURPASS@db.xxxx.supabase.co:5432/postgres

# ===== Watchdog settings =====
MAX_GAP_MINUTES=10
BACKFILL_MINUTES=180
WATCHDOG_INTERVAL_SECONDS=120

# Optional: webhook for alerts (Discord/Slack/etc)
# ALERT_WEBHOOK_URL=https://...
